# Better Auth
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET="your better auth secret"
BETTER_AUTH_URL="http://localhost:3000"

# Prisma / Postgres (matches docker-compose.yml)
DATABASE_URL="your postgres connection string"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="Your cloudinary cloudname"
NEXT_PUBLIC_CLOUDINARY_API_KEY="Your cloudinary api key"
CLOUDINARY_API_SECRET="Your cloudinary secret key"

# NEXT_PUBLIC_PUSHER_APP_KEY="Your pusher app key"
# PUSHER_APP_ID="Your pusher app id"
# PUSHER_SECRET="Your pusher secret"
# PUSHER_CLUSTER="Your pusher cluster"

NEXT_PUBLIC_PUSHER_APP_KEY="nextmatch-app-key" 
PUSHER_APP_ID="nextmatch-app-id" 
PUSHER_SECRET="nextmatch-app-secret" 
PUSHER_CLUSTER="app-cluster"

# Soketi (local Pusher-compatible server) 
NEXT_PUBLIC_PUSHER_HOST="127.0.0.1" 
NEXT_PUBLIC_PUSHER_PORT="6001" 
NEXT_PUBLIC_PUSHER_USE_TLS="false"